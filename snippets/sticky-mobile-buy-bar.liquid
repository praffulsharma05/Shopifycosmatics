{%- comment -%}
  Renders a mobile/tablet sticky bottom bar for quick Add to Cart on product detail page.
  Shows on screens ≤1024px (mobile + tablet). Desktop remains untouched.
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
<div id="StickyMobileBuyBar-{{ section.id }}" class="sticky-mobile-buy-bar">
  <div class="sticky-mobile-buy-bar__content">
    <div class="sticky-mobile-buy-bar__media">
      {%- if current_variant.featured_media -%}
        {{
          current_variant.featured_media
          | image_url: width: 100
          | image_tag: loading: 'lazy', class: 'sticky-mobile-buy-bar__img'
        }}
      {%- elsif product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 100
          | image_tag: loading: 'lazy', class: 'sticky-mobile-buy-bar__img'
        }}
      {%- endif -%}
    </div>
    <div class="sticky-mobile-buy-bar__info">
      <div class="sticky-mobile-buy-bar__title">{{ product.title | escape }}</div>
      <div class="sticky-mobile-buy-bar__price">
        <span class="sticky-mobile-buy-bar__price-current">
          {{ current_variant.price | money }}
        </span>
        {%- if current_variant.compare_at_price > current_variant.price -%}
          <span class="sticky-mobile-buy-bar__price-compare">
            {{ current_variant.compare_at_price | money }}
          </span>
        {%- endif -%}
      </div>
    </div>
    <div class="sticky-mobile-buy-bar__action">
      <button
        type="button"
        class="sticky-mobile-buy-bar__button"
        onclick="document.getElementById('ProductSubmitButton-{{ section.id }}')?.click();"
        {% unless current_variant.available %}
          disabled
        {% endunless %}
      >
        <span>
          {%- if current_variant.available -%}
            Add to Cart
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </span>
      </button>
    </div>
  </div>
</div>

<style>
  /* Hide on desktop (>1024px) */
  .sticky-mobile-buy-bar {
    display: none !important;
  }

  /* Show on mobile & tablet */
  @media screen and (max-width: 1024px) {
    .sticky-mobile-buy-bar {
      display: block !important;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 99;
      background: rgba(255, 255, 255, 0.97);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid #eaeaea;
      box-shadow: 0 -2px 16px rgba(0, 0, 0, 0.08);
      padding: 10px 16px;
      padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      transform: translateY(100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .sticky-mobile-buy-bar.is-visible {
      transform: translateY(0);
    }

    .sticky-mobile-buy-bar__content {
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 900px;
      margin: 0 auto;
    }

    .sticky-mobile-buy-bar__media {
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      border-radius: 8px;
      overflow: hidden;
      background: #f5f5f5;
      border: 1px solid #eaeaea;
    }

    .sticky-mobile-buy-bar__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .sticky-mobile-buy-bar__info {
      flex: 1;
      min-width: 0;
    }

    .sticky-mobile-buy-bar__title {
      font-size: 1.2rem;
      font-weight: 600;
      color: #111111;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.3;
    }

    .sticky-mobile-buy-bar__price {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 2px;
    }

    .sticky-mobile-buy-bar__price-current {
      font-size: 1.5rem;
      font-weight: 700;
      color: #111111;
    }

    .sticky-mobile-buy-bar__price-compare {
      font-size: 1.2rem;
      color: #999999;
      text-decoration: line-through;
    }

    .sticky-mobile-buy-bar__action {
      flex-shrink: 0;
    }

    .sticky-mobile-buy-bar__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0 20px;
      font-size: 1.3rem;
      font-weight: 700;
      color: #ffffff;
      background: #111111;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      white-space: nowrap;
      transition: transform 0.15s ease, background 0.15s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .sticky-mobile-buy-bar__button:active {
      transform: scale(0.97);
    }

    .sticky-mobile-buy-bar__button:disabled {
      background: #cccccc;
      cursor: not-allowed;
    }
  }

  /* Tablet: larger sizing */
  @media screen and (min-width: 768px) and (max-width: 1024px) {
    .sticky-mobile-buy-bar {
      padding: 12px 24px;
    }

    .sticky-mobile-buy-bar__media {
      width: 48px;
      height: 48px;
    }

    .sticky-mobile-buy-bar__title {
      font-size: 1.3rem;
    }

    .sticky-mobile-buy-bar__price-current {
      font-size: 1.6rem;
    }

    .sticky-mobile-buy-bar__button {
      min-height: 48px;
      padding: 0 28px;
      font-size: 1.4rem;
      border-radius: 8px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const stickyBar = document.getElementById('StickyMobileBuyBar-{{ section.id }}');
    const submitBtn = document.getElementById('ProductSubmitButton-{{ section.id }}');

    if (!stickyBar || !submitBtn) return;

    // Only activate on mobile/tablet
    const mql = window.matchMedia('(max-width: 1024px)');
    if (!mql.matches) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            stickyBar.classList.add('is-visible');
          } else {
            stickyBar.classList.remove('is-visible');
          }
        });
      },
      {
        threshold: 0.1,
      }
    );

    observer.observe(submitBtn);

    // Re-check on resize
    mql.addEventListener('change', function (e) {
      if (!e.matches) {
        stickyBar.classList.remove('is-visible');
      }
    });
  });
</script>
