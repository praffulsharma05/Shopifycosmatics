{% comment %}
  Floating Chat Bot Widget Snippet
  Renders a floating action button and chat window interface for customer support and AI guidance.
{% endcomment %}

<div id="chatbot-float-container" class="chatbot-float-container">
  <!-- Tooltip Preview -->
  <div id="chatbot-tooltip" class="chatbot-tooltip">
    <button class="chatbot-tooltip-close" id="chatbot-tooltip-close" aria-label="Close tooltip">&times;</button>
    <div class="chatbot-tooltip-content">
      <span class="chatbot-tooltip-wave">👋</span>
      <div>
        <strong>Need help?</strong>
        <p>Chat with our Beauty Assistant!</p>
      </div>
    </div>
  </div>

  <!-- Floating Button -->
  <button id="chatbot-toggle-btn" class="chatbot-toggle-btn" aria-label="Open support chat" aria-expanded="false">
    <span class="chatbot-online-badge"></span>
    <span class="chatbot-unread-dot" id="chatbot-unread-dot"></span>
    <svg class="chatbot-icon-chat" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    <svg class="chatbot-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Chat Window -->
  <div id="chatbot-window" class="chatbot-window" aria-hidden="true">
    <!-- Header -->
    <div class="chatbot-header">
      <div class="chatbot-header-info">
        <div class="chatbot-avatar-container">
          <div class="chatbot-avatar">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.38-1 1.72V7h2a5 5 0 0 1 5 5v1.26a3.5 3.5 0 0 1 1 6.74V21a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-1a3.5 3.5 0 0 1 1-6.74V12a5 5 0 0 1 5-5h2V5.72A2 2 0 0 1 12 2zm-3 8a3 3 0 0 0-3 3v2h12v-2a3 3 0 0 0-3-3H9zm0 4a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm6 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2z"/>
            </svg>
          </div>
          <span class="chatbot-avatar-status"></span>
        </div>
        <div>
          <h3 class="chatbot-title">Beauty Assistant</h3>
          <p class="chatbot-subtitle"><span class="chatbot-dot"></span> Online &bull; Instant Support</p>
        </div>
      </div>
      <div class="chatbot-header-actions">
        <button id="chatbot-clear-btn" class="chatbot-header-btn" title="Clear Chat" aria-label="Clear chat messages">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
        </button>
        <button id="chatbot-close-btn" class="chatbot-header-btn" title="Minimize" aria-label="Minimize chat">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="chatbot-messages" class="chatbot-messages">
      <!-- Welcome Message -->
      <div class="chatbot-msg chatbot-msg-bot">
        <div class="chatbot-msg-bubble">
          👋 Hello! Welcome to our store. How can I help you today?
          <div class="chatbot-msg-time">Just now</div>
        </div>
      </div>

      <!-- Suggestion Chips -->
      <div id="chatbot-suggestions" class="chatbot-suggestions">
        <button class="chatbot-chip" data-query="Track My Order">📦 Track Order</button>
        <button class="chatbot-chip" data-query="Best Sellers & Recommendations">✨ Best Sellers</button>
        <button class="chatbot-chip" data-query="Shipping & Delivery Info">🚚 Shipping Info</button>
        <button class="chatbot-chip" data-query="Return & Refund Policy">🔄 Returns</button>
        <button class="chatbot-chip" data-query="Skin Quiz & Makeup Advice">💄 Beauty Quiz</button>
        <button class="chatbot-chip" data-query="Available Discounts">🎁 Promo Codes</button>
      </div>
    </div>

    <!-- Typing Indicator (Hidden by default) -->
    <div id="chatbot-typing" class="chatbot-typing hidden">
      <div class="chatbot-typing-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span class="chatbot-typing-text">Assistant is typing...</span>
    </div>

    <!-- Footer / Input Box -->
    <form id="chatbot-form" class="chatbot-footer">
      <input 
        type="text" 
        id="chatbot-input" 
        class="chatbot-input" 
        placeholder="Type your message..." 
        autocomplete="off"
        required
      >
      <button type="submit" id="chatbot-send-btn" class="chatbot-send-btn" aria-label="Send message">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
    
    <div class="chatbot-powered-by">
      Powered by <span>AI Shopping Assistant</span>
    </div>
  </div>
</div>

<style>
  /* Base Container & Floating Button */
  .chatbot-float-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999999;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  /* Tooltip Preview */
  .chatbot-tooltip {
    position: absolute;
    bottom: 74px;
    right: 0;
    width: 230px;
    background: #ffffff;
    color: #111827;
    padding: 12px 14px;
    border-radius: 14px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: flex-start;
    animation: chatbot-pop-in 0.3s ease-out forwards;
    z-index: 999999;
  }
  .chatbot-tooltip.hidden {
    display: none !important;
  }
  .chatbot-tooltip-content {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .chatbot-tooltip-wave {
    font-size: 1.4rem;
  }
  .chatbot-tooltip strong {
    display: block;
    font-size: 1.3rem;
    font-weight: 600;
  }
  .chatbot-tooltip p {
    margin: 2px 0 0 0;
    font-size: 1.15rem;
    color: #6b7280;
  }
  .chatbot-tooltip-close {
    position: absolute;
    top: 4px;
    right: 6px;
    background: none;
    border: none;
    font-size: 1.4rem;
    color: #9ca3af;
    cursor: pointer;
    line-height: 1;
    padding: 2px;
  }
  .chatbot-tooltip-close:hover {
    color: #374151;
  }

  /* Toggle Button */
  .chatbot-toggle-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #111827 0%, #374151 100%);
    color: #ffffff;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(17, 24, 39, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease, background 0.3s ease;
  }
  .chatbot-toggle-btn:hover {
    transform: scale(1.08) translateY(-2px);
    box-shadow: 0 12px 28px rgba(17, 24, 39, 0.45);
  }
  .chatbot-toggle-btn:active {
    transform: scale(0.95);
  }
  .chatbot-toggle-btn svg {
    width: 26px;
    height: 26px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .chatbot-icon-close {
    display: none;
    position: absolute;
  }
  .chatbot-float-container.is-open .chatbot-icon-chat {
    display: none;
  }
  .chatbot-float-container.is-open .chatbot-icon-close {
    display: block;
  }
  .chatbot-float-container.is-open .chatbot-toggle-btn {
    background: linear-gradient(135deg, #374151 0%, #1f2937 100%);
  }

  /* Status Badges */
  .chatbot-online-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 13px;
    height: 13px;
    background-color: #10b981;
    border: 2px solid #ffffff;
    border-radius: 50%;
  }
  .chatbot-unread-dot {
    position: absolute;
    top: -2px;
    left: -2px;
    width: 14px;
    height: 14px;
    background-color: #ef4444;
    border: 2px solid #ffffff;
    border-radius: 50%;
    display: none;
    animation: chatbot-pulse 1.5s infinite;
  }

  /* Chat Window */
  .chatbot-window {
    position: absolute;
    bottom: 76px;
    right: 0;
    width: 380px;
    height: 540px;
    max-height: calc(100vh - 120px);
    background: #ffffff;
    border-radius: 20px;
    box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.22), 0 0 15px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(20px) scale(0.95);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
    z-index: 999998;
  }
  .chatbot-float-container.is-open .chatbot-window {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* Header */
  .chatbot-header {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    color: #ffffff;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .chatbot-header-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .chatbot-avatar-container {
    position: relative;
  }
  .chatbot-avatar {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .chatbot-avatar svg {
    width: 22px;
    height: 22px;
    fill: #ffffff;
  }
  .chatbot-avatar-status {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 10px;
    height: 10px;
    background-color: #10b981;
    border: 2px solid #111827;
    border-radius: 50%;
  }
  .chatbot-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
  }
  .chatbot-subtitle {
    margin: 2px 0 0 0;
    font-size: 1.15rem;
    color: #9ca3af;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .chatbot-dot {
    width: 6px;
    height: 6px;
    background-color: #10b981;
    border-radius: 50%;
    display: inline-block;
  }
  .chatbot-header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .chatbot-header-btn {
    background: transparent;
    border: none;
    color: #9ca3af;
    cursor: pointer;
    padding: 6px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .chatbot-header-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.1);
  }
  .chatbot-header-btn svg {
    width: 18px;
    height: 18px;
  }

  /* Messages List */
  .chatbot-messages {
    flex: 1;
    padding: 16px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background-color: #f9fafb;
    scroll-behavior: smooth;
  }
  .chatbot-messages::-webkit-scrollbar {
    width: 5px;
  }
  .chatbot-messages::-webkit-scrollbar-thumb {
    background: #e5e7eb;
    border-radius: 10px;
  }

  .chatbot-msg {
    display: flex;
    flex-direction: column;
    max-width: 85%;
  }
  .chatbot-msg-bot {
    align-self: flex-start;
  }
  .chatbot-msg-user {
    align-self: flex-end;
  }

  .chatbot-msg-bubble {
    padding: 12px 16px;
    font-size: 1.35rem;
    line-height: 1.45;
    word-break: break-word;
    white-space: pre-line;
    position: relative;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  .chatbot-msg-bot .chatbot-msg-bubble {
    background: #ffffff;
    color: #1f2937;
    border: 1px solid #e5e7eb;
    border-radius: 16px 16px 16px 4px;
  }
  .chatbot-msg-user .chatbot-msg-bubble {
    background: linear-gradient(135deg, #111827 0%, #374151 100%);
    color: #ffffff;
    border-radius: 16px 16px 4px 16px;
  }
  .chatbot-msg-time {
    font-size: 1.0rem;
    margin-top: 4px;
    opacity: 0.65;
    text-align: right;
  }

  /* Chips / Suggestions */
  .chatbot-suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
  }
  .chatbot-chip {
    background: #ffffff;
    border: 1px solid #d1d5db;
    color: #374151;
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: all 0.2s ease;
    font-weight: 500;
  }
  .chatbot-chip:hover {
    background: #111827;
    color: #ffffff;
    border-color: #111827;
  }

  /* Typing Indicator */
  .chatbot-typing {
    padding: 8px 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #f9fafb;
  }
  .chatbot-typing.hidden {
    display: none;
  }
  .chatbot-typing-dots {
    display: flex;
    gap: 4px;
  }
  .chatbot-typing-dots span {
    width: 6px;
    height: 6px;
    background-color: #9ca3af;
    border-radius: 50%;
    animation: chatbot-bounce 1.4s infinite ease-in-out both;
  }
  .chatbot-typing-dots span:nth-child(1) { animation-delay: -0.32s; }
  .chatbot-typing-dots span:nth-child(2) { animation-delay: -0.16s; }
  .chatbot-typing-text {
    font-size: 1.15rem;
    color: #6b7280;
    font-style: italic;
  }

  /* Footer & Input */
  .chatbot-footer {
    padding: 12px 16px;
    background: #ffffff;
    border-top: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .chatbot-input {
    flex: 1;
    border: 1px solid #d1d5db;
    border-radius: 24px;
    padding: 10px 16px;
    font-size: 1.35rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    background: #f9fafb;
    color: #111827;
  }
  .chatbot-input:focus {
    border-color: #111827;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(17, 24, 39, 0.08);
  }
  .chatbot-send-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #111827;
    color: #ffffff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }
  .chatbot-send-btn:hover {
    background: #374151;
    transform: scale(1.05);
  }
  .chatbot-send-btn svg {
    width: 18px;
    height: 18px;
    margin-left: -2px;
  }

  .chatbot-powered-by {
    text-align: center;
    font-size: 1.0rem;
    color: #9ca3af;
    background: #ffffff;
    padding-bottom: 8px;
  }
  .chatbot-powered-by span {
    font-weight: 600;
    color: #6b7280;
  }

  /* Animations */
  @keyframes chatbot-pop-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes chatbot-pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(239, 68, 68, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
  }
  @keyframes chatbot-bounce {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1.0); }
  }

  /* Mobile Responsive */
  @media (max-width: 480px) {
    .chatbot-float-container {
      bottom: 16px;
      right: 16px;
    }
    .chatbot-window {
      width: calc(100vw - 32px);
      height: calc(100vh - 120px);
      right: 0;
      bottom: 70px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('chatbot-float-container');
    const toggleBtn = document.getElementById('chatbot-toggle-btn');
    const closeBtn = document.getElementById('chatbot-close-btn');
    const clearBtn = document.getElementById('chatbot-clear-btn');
    const tooltip = document.getElementById('chatbot-tooltip');
    const tooltipClose = document.getElementById('chatbot-tooltip-close');
    const form = document.getElementById('chatbot-form');
    const input = document.getElementById('chatbot-input');
    const messages = document.getElementById('chatbot-messages');
    const typing = document.getElementById('chatbot-typing');
    const unreadDot = document.getElementById('chatbot-unread-dot');

    // Show tooltip initially after 2.5s if not opened before
    setTimeout(() => {
      if (!sessionStorage.getItem('chatbot_opened') && !container.classList.contains('is-open')) {
        tooltip.classList.remove('hidden');
      }
    }, 2500);

    if (tooltipClose) {
      tooltipClose.addEventListener('click', function(e) {
        e.stopPropagation();
        tooltip.classList.add('hidden');
      });
    }

    // Toggle Chat Window
    function toggleChat() {
      const isOpen = container.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', isOpen);
      document.getElementById('chatbot-window').setAttribute('aria-hidden', !isOpen);
      
      if (isOpen) {
        tooltip.classList.add('hidden');
        unreadDot.style.display = 'none';
        sessionStorage.setItem('chatbot_opened', 'true');
        setTimeout(() => input.focus(), 300);
      }
    }

    toggleBtn.addEventListener('click', toggleChat);
    closeBtn.addEventListener('click', toggleChat);

    // Knowledge base responses
    const botResponses = [
      {
        keywords: ['track', 'order', 'status', 'where is my'],
        reply: "📦 You can track your order using your Order ID in your email confirmation, or visit our Account page to see real-time shipping updates."
      },
      {
        keywords: ['shipping', 'delivery', 'deliver', 'time', 'how long'],
        reply: "🚚 Standard shipping takes 3-5 business days. Express shipping takes 1-2 business days. Orders over $50 get FREE standard shipping!"
      },
      {
        keywords: ['return', 'refund', 'exchange', 'policy'],
        reply: "🔄 We offer a hassle-free 30-day money-back guarantee on all unopened & gently used items! Check our Return Policy page for step-by-step instructions."
      },
      {
        keywords: ['discount', 'promo', 'coupon', 'code', 'offer', 'sale'],
        reply: "🎁 Use code **WELCOME10** at checkout for 10% off your first order! Don't forget to subscribe to our newsletter for exclusive insider deals."
      },
      {
        keywords: ['best seller', 'recommend', 'recommendation', 'popular', 'top'],
        reply: "✨ Our current best sellers include our Hydrating Glow Serum, Matte Finish Lipstick, and Organic Rosewater Facial Toner. Would you like details on any of these?"
      },
      {
        keywords: ['skin', 'quiz', 'shade', 'makeup', 'type', 'routine'],
        reply: "💄 Our products are formulated for sensitive, dry, oily, and combination skin types. Try our bestselling All-Day Hydration Moisturizer or contact us for personalized advice!"
      },
      {
        keywords: ['human', 'agent', 'support', 'contact', 'phone', 'email', 'talk'],
        reply: "👩‍💼 Need human support? Our care team is available Mon-Fri, 9am-6pm EST. You can email us directly at support@example.com or reply here and an agent will follow up!"
      }
    ];

    function getBotReply(userText) {
      const lower = userText.toLowerCase();
      for (const item of botResponses) {
        if (item.keywords.some(k => lower.includes(k))) {
          return item.reply;
        }
      }
      return "Thank you for reaching out! I've noted your query: \"" + userText + "\". How else can I assist you, or would you like to speak to customer support?";
    }

    function getTimeString() {
      const now = new Date();
      return now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function appendMessage(text, sender) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `chatbot-msg chatbot-msg-${sender}`;

      const bubbleDiv = document.createElement('div');
      bubbleDiv.className = 'chatbot-msg-bubble';
      bubbleDiv.innerText = text;

      const timeDiv = document.createElement('div');
      timeDiv.className = 'chatbot-msg-time';
      timeDiv.innerText = getTimeString();

      bubbleDiv.appendChild(timeDiv);
      msgDiv.appendChild(bubbleDiv);

      // Insert before typing indicator
      messages.appendChild(msgDiv);
      messages.scrollTop = messages.scrollHeight;
    }

    function showTyping() {
      typing.classList.remove('hidden');
      messages.scrollTop = messages.scrollHeight;
    }

    function hideTyping() {
      typing.classList.add('hidden');
    }

    function handleSend(userText) {
      if (!userText.trim()) return;

      appendMessage(userText, 'user');
      input.value = '';

      showTyping();

      setTimeout(() => {
        hideTyping();
        const reply = getBotReply(userText);
        appendMessage(reply, 'bot');
      }, 1000 + Math.random() * 600);
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      handleSend(input.value);
    });

    // Chip Click Listener
    messages.addEventListener('click', function(e) {
      if (e.target.classList.contains('chatbot-chip')) {
        const query = e.target.getAttribute('data-query') || e.target.innerText;
        handleSend(query);
      }
    });

    // Clear Chat
    clearBtn.addEventListener('click', function() {
      messages.innerHTML = `
        <div class="chatbot-msg chatbot-msg-bot">
          <div class="chatbot-msg-bubble">
            👋 Chat cleared. How can I help you today?
            <div class="chatbot-msg-time">${getTimeString()}</div>
          </div>
        </div>
        <div id="chatbot-suggestions" class="chatbot-suggestions">
          <button class="chatbot-chip" data-query="Track My Order">📦 Track Order</button>
          <button class="chatbot-chip" data-query="Best Sellers & Recommendations">✨ Best Sellers</button>
          <button class="chatbot-chip" data-query="Shipping & Delivery Info">🚚 Shipping Info</button>
          <button class="chatbot-chip" data-query="Return & Refund Policy">🔄 Returns</button>
          <button class="chatbot-chip" data-query="Skin Quiz & Makeup Advice">💄 Beauty Quiz</button>
          <button class="chatbot-chip" data-query="Available Discounts">🎁 Promo Codes</button>
        </div>
      `;
    });
  });
</script>
