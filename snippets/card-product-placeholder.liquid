{% comment %}
  Renders placeholder product card.
  Accepts:
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - image_shape: {String} Image mask to apply to the product image card.
  - extend_height: {Boolean} Card height extends to available container space.
  - placeholder_image: {String} The placeholder image to use.
  - show_vendor: {Boolean} Show the product vendor.
{% endcomment %}
{%- liquid
  assign ratio = 1
  assign placeholder = true
  if media_aspect_ratio == 'portrait'
    assign ratio = 0.8
  endif
-%}
<div class="card-wrapper product-card-wrapper underline-links-hover" style="border-radius: 0; overflow: hidden; display: flex; flex-direction: column; height: 100%;">
  <div
    class="
      card card--{{ settings.card_style }}
      card--media
      {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
      {% if image_shape and image_shape != 'default' %} card--shape{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
    "
    style="border-radius: 0; overflow: hidden; background: transparent; display: flex; flex-direction: column; height: 100%;"
  >
    <div
      class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}"
      style="border-radius: 8px 8px 0 0; overflow: hidden; background: #f8f8f8; position: relative; display: flex; flex-direction: column; flex: 1 1 auto;"
    >
      <div class="card__media{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }} gradient{% endif %}" style="position: relative; width: 100%; height: 0; padding-top: 100%; overflow: hidden;">
        <div class="media media--transparent" style="background: #f8f8f8; width: 100%; height: 100%; position: absolute; top: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 1rem;">
          {%- if placeholder_image -%}
            {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
          {%- else -%}
            {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
        </div>
      </div>
    </div>
    <div class="card__content" style="padding: 0.8rem 0.8rem 1.4rem 0.8rem; text-align: center; display: flex; flex-direction: column; flex: 1 1 auto; justify-content: space-between; box-sizing: border-box; width: 100%; background: #ffffff;">
      <div class="card__information" style="text-align: center; width: 100%; display: flex; flex-direction: column; flex: 1 1 auto; justify-content: flex-start; align-items: center; padding: 0; margin: 0;">
        {%- if show_vendor -%}
          <div class="card__vendor" style="font-size: 1.1rem; color: #888; text-transform: none; letter-spacing: 0; margin-bottom: 2px;">
            {{ 'products.product.vendor' | t }}
          </div>
        {%- endif -%}
        <h3
          class="card__heading h5"
          style="color: #1a1a1a; font-size: 1.25rem; font-weight: 700; text-align: center; margin: 0 0 4px 0; padding: 0; text-transform: uppercase; letter-spacing: 0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; display: block;"
        >
          <a role="link" aria-disabled="true" class="full-unstyled-link" style="color: #1a1a1a; text-decoration: none;">
            Example Product Title
          </a>
        </h3>
        <div class="card-information" style="text-align: center; width: 100%; margin-top: auto; padding: 0;">
          {% render 'price', placeholder: placeholder, show_compare_at_price: true %}
        </div>
      </div>
    </div>
  </div>
</div>
