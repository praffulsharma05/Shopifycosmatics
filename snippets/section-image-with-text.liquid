{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Full-width Horizontal Banner Custom Overrides */
  .banner-container-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .banner-media-{{ section.id }} {
    position: relative;
    width: 100%;
    height: auto;
    min-height: 200px; /* Reduced minimum height for mobile */
  }

  @media screen and (min-width: 750px) {
    .banner-media-{{ section.id }} {
      min-height: {{ section.settings.desktop_banner_height }}px;
    }
  }

  .banner-media-{{ section.id }} img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .banner-overlay-content-{{ section.id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    padding: 2rem;
    z-index: 2;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
    
    /* Layout positioning assignments based on schema selections */
    justify-content: {% if section.settings.desktop_content_alignment == 'left' %}flex-start{% elsif section.settings.desktop_content_alignment == 'right' %}flex-end{% else %}center{% endif %};
    align-items: {% if section.settings.desktop_content_position == 'top' %}flex-start{% elsif section.settings.desktop_content_position == 'bottom' %}flex-end{% else %}center{% endif %};
  }

  .banner-text-card-{{ section.id }} {
    max-width: 320px; /* Marginally narrower card for a sleeker look */
    width: 100%;
    padding: 2rem 2.5rem; /* Reduced inner card padding */
    border-radius: 20px;
    text-align: {{ section.settings.desktop_content_alignment }};
  }

  /* Target and reduce core typographic elements inside the banner */
  .banner-text-card-{{ section.id }} .image-with-text__heading {
    margin-top: 0;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  
  /* Surgical font-size limits to ensure text sizes stay compact */
  .banner-text-card-{{ section.id }} .h2 { font-size: calc(var(--font-heading-scale) * 1.6rem); }
  .banner-text-card-{{ section.id }} .h1 { font-size: calc(var(--font-heading-scale) * 2.0rem); }
  .banner-text-card-{{ section.id }} .h0 { font-size: calc(var(--font-heading-scale) * 2.4rem); }
  .banner-text-card-{{ section.id }} .hxl { font-size: calc(var(--font-heading-scale) * 2.8rem); }

  .banner-text-card-{{ section.id }} .image-with-text__text {
    font-size: 1.3rem; /* Scaled down body text from 1.6rem baseline */
    line-height: 1.4;
  }

  .banner-text-card-{{ section.id }} .image-with-text__text--caption {
    font-size: 1.1rem; /* Scaled down caption text */
    margin-bottom: 0.5rem;
  }

  @media screen and (max-width: 749px) {
    .banner-overlay-content-{{ section.id }} {
      justify-content: center;
      align-items: center;
    }
    .banner-text-card-{{ section.id }} {
      text-align: {{ section.settings.mobile_content_alignment }};
      padding: 1.2rem;
    }
    .banner-text-card-{{ section.id }} .h2 { font-size: 1.4rem; }
    .banner-text-card-{{ section.id }} .h1 { font-size: 1.6rem; }
    .banner-text-card-{{ section.id }} .h0 { font-size: 1.8rem; }
    .banner-text-card-{{ section.id }} .hxl { font-size: 2.0rem; }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="banner-container-{{ section.id }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    
    <div class="banner-media-{{ section.id }}">
      {%- if section.settings.image != blank -%}
        {%- assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000' -%}
        {%- capture sizes -%}100vw{%- endcapture -%}
        {{
          section.settings.image
          | image_url: width: 3000
          | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    <div class="banner-overlay-content-{{ section.id }}">
      <div class="banner-text-card-{{ section.id }} content-container gradient color-{{ section.settings.color_scheme }}">
        {%- for block in section.blocks -%}
          {% case block.type %}
            {%- when 'heading' -%}
              <h2 class="image-with-text__heading inline-richtext {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading }}
              </h2>
            {%- when 'caption' -%}
              <p class="image-with-text__text image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.caption | escape }}
              </p>
            {%- when 'text' -%}
              <div class="image-with-text__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <div style="margin-top: 1rem;">
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button button--small {% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.button_label | escape }}
                  </a>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>
