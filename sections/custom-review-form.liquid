      "label": "Show Admin Moderation Button on Storefront",
      "default": false,
      "info": "Keep unchecked to hide the moderation button from public customers. You can access admin moderation anytime by adding ?admin=true to the page URL."
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews"
    }
  ]
}
