{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0px !important;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 0px !important;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Collapse gap from page header section above */
  .shopify-section:has(.main-page-title) div[class*="-padding"] {
    padding-bottom: 0px !important;
    padding-top: 1.5rem !important;
  }
  .shopify-section:has(.main-page-title) .page-width--narrow {
    max-width: 120rem !important;
  }
  .main-page-title,
  .main-page-title.page-title,
  .main-page-title.h0,
  h1.page-title {
    display: none !important;
  }

  /* Contact Page Heading */
  .contact-page-heading {
    text-align: center !important;
    margin: 0 0 4rem 0 !important;
    font-size: 3.6rem !important;
    font-weight: 700 !important;
    color: rgb(var(--color-foreground)) !important;
  }

  /* Contact Cards Grid */
  .contact-cards-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 2.5rem !important;
    width: 100% !important;
  }

  @media screen and (max-width: 749px) {
    .contact-cards-grid {
      grid-template-columns: 1fr !important;
    }
  }

  /* Individual card styling */
  .contact-info-card {
    border: 1px solid rgba(var(--color-foreground), 0.12) !important;
    border-radius: 16px !important;
    padding: 3.5rem 2.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    background: #fff !important;
    transition: all 0.3s ease !important;
  }

  .contact-info-card:hover {
    transform: translateY(-5px) !important;
    box-shadow: 0 12px 30px rgba(0,0,0,0.08) !important;
    border-color: rgba(var(--color-foreground), 0.25) !important;
  }

  .contact-card-icon {
    margin-bottom: 1.8rem !important;
    color: rgb(var(--color-foreground)) !important;
  }

  .contact-card-title {
    margin: 0 0 1rem 0 !important;
    font-size: 1.8rem !important;
    font-weight: 700 !important;
    color: rgb(var(--color-foreground)) !important;
  }

  .contact-card-detail {
    margin: 0 0 2rem 0 !important;
    font-size: 1.4rem !important;
    color: rgba(var(--color-foreground), 0.75) !important;
    font-weight: 500 !important;
    line-height: 1.7 !important;
  }

  .contact-card-btn {
    display: inline-block !important;
    background: #ffc107 !important;
    color: #000 !important;
    font-size: 1.2rem !important;
    font-weight: 700 !important;
    border-radius: 4px !important;
    padding: 1rem 2.5rem !important;
    text-decoration: none !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08rem !important;
    transition: all 0.3s ease !important;
    border: 2px solid #ffc107 !important;
    margin-top: auto !important;
  }

  .contact-card-btn:hover {
    background: transparent !important;
    color: #000 !important;
  }

  /* Address card — same size as others */
  .contact-info-card--address {
    max-width: none !important;
  }

  @media screen and (max-width: 749px) {
    .contact-info-card--address {
      max-width: 100% !important;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding">
    
    <h2 class="contact-page-heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">Need to contact us?</h2>

    <div class="contact-cards-grid{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      
      <!-- Card 1: Whatsapp -->
      <div class="contact-info-card">
        <div class="contact-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        </div>
        <h3 class="contact-card-title">Whatsapp</h3>
        <p class="contact-card-detail">+91 7400097974</p>
        <a href="https://wa.me/917400097974" target="_blank" class="contact-card-btn">Whatsapp Us</a>
      </div>

      <!-- Card 2: Phone -->
      <div class="contact-info-card">
        <div class="contact-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        </div>
        <h3 class="contact-card-title">Phone</h3>
        <p class="contact-card-detail">+91 7400097974</p>
        <a href="tel:+917400097974" class="contact-card-btn">Call Us</a>
      </div>

      <!-- Card 3: Corporate ID -->
      <div class="contact-info-card">
        <div class="contact-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <h3 class="contact-card-title">Corporate Identification Number</h3>
        <p class="contact-card-detail" style="margin-bottom: 0 !important;">U52609MH2019PTC329867</p>
      </div>

      <!-- Card 4: Address -->
      <div class="contact-info-card contact-info-card--address">
        <div class="contact-card-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="9" y1="22" x2="9" y2="16"></line><line x1="15" y1="22" x2="15" y2="16"></line><line x1="9" y1="16" x2="15" y2="16"></line><path d="M9 6h6"></path><path d="M9 10h6"></path></svg>
        </div>
        <h3 class="contact-card-title">Consumer Care Address</h3>
        <p class="contact-card-detail" style="margin-bottom: 0 !important; max-width: 450px;">
          Heavenly Secrets Pvt. Ltd., 803, 8th Floor, Wing E of Times Square Building, Andheri Kurla Road, Marol, Andheri East, Mumbai, Maharashtra, 400059
        </p>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
