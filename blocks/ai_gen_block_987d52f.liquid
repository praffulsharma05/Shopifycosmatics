      "id": "button_text_color",
      "label": "Text color",
      "default": "#fdfbf7"
    },
    {
      "type": "range",
      "id": "button_padding",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 14
