          {% if block.settings.slide_2_image %}
            <img
              src="{{ block.settings.slide_2_image | image_url: width: 2000 }}"
              alt="{{ block.settings.slide_2_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.slide_2_image.width }}"
              height="{{ block.settings.slide_2_image.height }}"
              class="ai-carousel-slide-image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-carousel-slide-placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.slide_2_heading != blank or block.settings.slide_2_subheading != blank %}
            <div class="ai-carousel-overlay-{{ ai_gen_id }}">
              <div class="ai-carousel-content-{{ ai_gen_id }}">
                {% if block.settings.slide_2_heading != blank %}
                  <h2 class="ai-carousel-heading-{{ ai_gen_id }}">{{ block.settings.slide_2_heading }}</h2>
                {% endif %}
                {% if block.settings.slide_2_subheading != blank %}
