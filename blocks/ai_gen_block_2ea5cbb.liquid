<script>
  (function() {
    class CarouselSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayTimer = null;
        this.isAutoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;
      }

      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.ai-carousel-slide-{{ ai_gen_id }}'));
        this.totalSlides = this.slides.length;

        if (this.totalSlides === 0) return;

        this.setupDots();
        this.setupArrows();

        if (this.isAutoplay) {
          this.startAutoplay();
          this.addEventListener('mouseenter', () => this.stopAutoplay());
          this.addEventListener('mouseleave', () => this.startAutoplay());
        }
      }

      setupDots() {
        const dotsContainer = this.querySelector('.ai-carousel-dots-{{ ai_gen_id }}');
        if (!dotsContainer) return;

        dotsContainer.innerHTML = '';
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-carousel-dot-{{ ai_gen_id }}';
          if (i === 0) dot.classList.add('active');
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          dotsContainer.appendChild(dot);
        }
        this.dots = Array.from(dotsContainer.querySelectorAll('.ai-carousel-dot-{{ ai_gen_id }}'));
      }

      setupArrows() {
        const arrows = this.querySelectorAll('.ai-carousel-arrow-{{ ai_gen_id }}');
        arrows.forEach(arrow => {
          arrow.addEventListener('click', () => {
            const direction = arrow.dataset.direction;
            if (direction === 'next') {
              this.nextSlide();
            } else {
              this.prevSlide();
            }
          });
        });
      }

      goToSlide(index) {
        this.slides[this.currentSlide].classList.remove('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.remove('active');
        }

        this.currentSlide = index;

        this.slides[this.currentSlide].classList.add('active');
        if (this.dots && this.dots[this.currentSlide]) {
          this.dots[this.currentSlide].classList.add('active');
        }

        if (this.isAutoplay) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.totalSlides;
        this.goToSlide(nextIndex);
      }

      prevSlide() {
        const prevIndex = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.goToSlide(prevIndex);
      }

      startAutoplay() {
        if (!this.isAutoplay) return;
        this.autoplayTimer = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('carousel-slideshow-{{ ai_gen_id }}', CarouselSlideshow{{ ai_gen_id }});
  })();
</script>

